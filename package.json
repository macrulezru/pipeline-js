{
  "name": "rest-pipeline-js",
  "version": "2.1.2",
  "description": "Orchestrate REST API calls in sequential and parallel pipelines with retry, caching, rate limiting and SSE streaming. Vanilla JS / Vue 3 / React.",
  "author": "macrulez <macrulezru@gmail.com> (https://macrulez.ru/en)",
  "license": "MIT",
  "homepage": "https://npm.vuecraft.ru/en/packages/rest-pipeline-js/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macrulezru/pipeline-js.git"
  },
  "bugs": {
    "url": "https://github.com/macrulezru/pipeline-js/issues"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/umd/rest-pipeline.umd.min.js",
  "jsdelivr": "dist/umd/rest-pipeline.umd.min.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./vue": {
      "types": "./dist/esm/plugins/vue/index.d.ts",
      "import": "./dist/esm/plugins/vue/index.js",
      "require": "./dist/cjs/plugins/vue/index.js"
    },
    "./react": {
      "types": "./dist/esm/plugins/react/index.d.ts",
      "import": "./dist/esm/plugins/react/index.js",
      "require": "./dist/cjs/plugins/react/index.js"
    },
    "./testing": {
      "types": "./dist/esm/testing.d.ts",
      "import": "./dist/esm/testing.js",
      "require": "./dist/cjs/testing.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/postbuild.mjs && node scripts/build-umd.mjs",
    "verify:esm": "node --input-type=module -e \"import('./dist/esm/index.js').then(()=>console.log('ESM entry OK')).then(()=>import('./dist/esm/plugins/vue/index.js')).then(()=>console.log('ESM /vue entry OK')).then(()=>import('./dist/esm/plugins/react/index.js')).then(()=>console.log('ESM /react entry OK')).then(()=>import('./dist/esm/testing.js')).then(()=>console.log('ESM /testing entry OK'))\"",
    "test": "vitest run",
    "test:types": "vitest --typecheck --run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "size": "npm run build && size-limit",
    "demo:vue": "npm run start-demo-vite",
    "start-demo-vite": "vite --config vite.config.js"
  },
  "keywords": [
    "rest",
    "api",
    "pipeline",
    "orchestration",
    "retry",
    "cache",
    "rate-limit",
    "sse",
    "axios",
    "vue",
    "react",
    "typescript"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "axios": "^1.13.2"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^12.1.0",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19.2.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.6.2",
    "jsdom": "^27.4.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "scheduler": "^0.27.0",
    "size-limit": "^12.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.17",
    "vue": "^3.5.26",
    "vue-eslint-parser": "^10.2.0",
    "ws": "^8.21.3"
  }
}
